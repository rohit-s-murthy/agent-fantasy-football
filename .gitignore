__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Generated/cached data — regenerated by the code, not source
data/*.json
logs/*.json

# state/league_<season>.json is the opposite: it's the actual record of each
# season's draft (LLM picks aren't reproducible), so it IS source and is
# tracked. Anything else under state/ stays ignored.
state/*.json
!state/league_*.json
